ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=cloud
LOCAL_LLM_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=gemma-4-26B-A4B-it-qat-q4_0
ALLOWED_EMAIL=
PII_BLOCK=
STORE_DRAFTS=true
DATABASE_URL=file:./data/grammer.db
FAKE_PROVIDER=                # 1이면 API 키 없이 결정적 가짜 provider로 UI 흐름만 확인(개발·E2E 전용)
CLOUD_BACKEND=api             # api(기본, ANTHROPIC_API_KEY 필요) | claude-cli(개인 테스트: Claude Code 구독 로그인으로 `claude -p` 호출)
CLAUDE_CLI_PATH=claude        # claude-cli일 때 실행 파일 경로(PATH에 없으면 `which claude` 결과)
CLAUDE_CLI_MODEL=claude-sonnet-5
STUDIO_PLAN_MODEL=            # 비우면 기본 모델. 스튜디오 의도 정리·티켓 분류만 이 모델로(예: claude-sonnet-5). 클라우드에만 적용
CORRECTION_MODEL=             # 비우면 기본 모델. 교정만 이 모델로. 클라우드에만 적용
JIRA_BASE_URL=                # Jira 티켓 → 프롬프트. 예: https://xxx.atlassian.net (셋 다 있어야 켜짐, DEMO-1 은 없이도 동작)
JIRA_EMAIL=                   # Atlassian 계정 이메일
JIRA_API_TOKEN=               # id.atlassian.com → 보안 → API 토큰
LOG_FILE=                     # 비우면 터미널에만. 경로를 주면 진행 로그를 파일에도 덧붙임
CLAUDE_CLI_LOG=               # claude-cli 백엔드의 stream-json 원문을 그대로 기록(진단용)
WORKSPACE_PROFILE=            # 작업 공간 프로필 경로(루트 기준). 비우면 루트 studio.workspace.json. 예시: studio.workspace.example.json

# ── 팀 서버 로그인(OIDC). 셋(ISSUER·CLIENT_ID·CLIENT_SECRET)이 다 있으면 켜진다. 비우면 로그인 없는 단일 사용자 모드. docs/05 §E ──
OIDC_ISSUER=                  # 구글: https://accounts.google.com · Okta: https://xxx.okta.com · Azure: https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_SECRET=                  # 세션 쿠키 서명 키. `openssl rand -base64 32`
APP_URL=                      # 외부 접속 주소(콜백 = <APP_URL>/api/auth/callback). 리버스 프록시 뒤면 필수
AUTH_ALLOWED_DOMAINS=         # 이 도메인 이메일은 모두 허용. 예: example.com
AUTH_ALLOWED_EMAILS=          # 도메인 밖 예외. 쉼표로
AUTH_ADMIN_EMAILS=            # 설정 화면을 열 수 있는 사람. 비어 있으면 아무도 못 연다

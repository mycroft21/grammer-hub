ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=cloud
LOCAL_LLM_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=gemma-4-26B-A4B-it-qat-q4_0
ALLOWED_EMAIL=
PII_BLOCK=
STORE_DRAFTS=true
DATABASE_URL=file:./data/grammer.db
FAKE_PROVIDER=                # 1이면 API 키 없이 결정적 가짜 provider로 UI 흐름만 확인(개발·E2E 전용)
CLOUD_BACKEND=api             # api(기본, ANTHROPIC_API_KEY 필요) | claude-cli(개인 테스트: Claude Code 구독 로그인으로 `claude -p` 호출)
CLAUDE_CLI_PATH=claude        # claude-cli일 때 실행 파일 경로(PATH에 없으면 `which claude` 결과)
CLAUDE_CLI_MODEL=claude-sonnet-5
